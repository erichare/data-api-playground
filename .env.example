# Data API data backend
# Optional if you prefer entering credentials in the UI at runtime.
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your-token
ASTRA_DB_API_ENDPOINT=https://your-db-id.apps.astra.datastax.com
# Optional. Defaults to default_keyspace when the app requests one explicitly.
ASTRA_DB_KEYSPACE=default_keyspace

# DataStax HCD data backend
# Optional alternative to Astra. If both Astra and HCD are configured,
# the app prefers Astra as the default env-backed data connection.
HCD_DATA_API_ENDPOINT=https://your-hcd-host:8181
HCD_USERNAME=cassandra
HCD_PASSWORD=your-password
HCD_KEYSPACE=your_keyspace

# OpenRAG knowledge backend
# Optional. Used when you switch the knowledge backend mode to OpenRAG.
# OPENRAG_URL defaults to http://localhost:3000 when omitted.
OPENRAG_API_KEY=orag_your_token
OPENRAG_URL=http://localhost:3000

# Hugging Face
# Optional. When set, the app uses Hugging Face for chat, titles, and embeddings.
HUGGINGFACE_API_KEY=hf_your_token
HUGGINGFACE_CHAT_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HUGGINGFACE_EMBED_MODEL=ibm-granite/granite-embedding-125m-english

# Ollama
# Used automatically when no Hugging Face key is available.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=granite3.1-dense:8b
OLLAMA_EMBED_MODEL=granite-embedding:278m

# Optional app-level authentication
# In production, password auth is required unless you explicitly opt into public access.
# In local dev/test, the app remains public by default for convenience.
# PLAYGROUND_AUTH_PASSWORD accepts a plaintext value or a bcrypt hash ($2b$10$...).
# Generate a bcrypt hash: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
PLAYGROUND_AUTH_PASSWORD=choose-a-strong-password
PLAYGROUND_AUTH_SECRET=replace-with-a-long-random-secret
PLAYGROUND_ALLOW_UNAUTHENTICATED=false

# Optional local override for the SQLite database file
DATA_API_PLAYGROUND_DB_PATH=/absolute/path/to/app.db
