# Astra DB
# Optional if you prefer entering credentials in the UI at runtime.
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your-token
ASTRA_DB_API_ENDPOINT=https://your-db-id.apps.astra.datastax.com

# Hugging Face
# Optional. When set, the app uses Hugging Face for chat, titles, and embeddings.
HUGGINGFACE_API_KEY=hf_your_token
HUGGINGFACE_CHAT_MODEL=ibm-granite/granite-3.3-8b-instruct
HUGGINGFACE_EMBED_MODEL=ibm-granite/granite-embedding-125m-english

# Ollama
# Used automatically when no Hugging Face key is available.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=granite3.1-dense:8b
OLLAMA_EMBED_MODEL=granite-embedding:278m

# Optional app-level authentication
# If set, the app requires login and uses an httpOnly session cookie.
PLAYGROUND_AUTH_PASSWORD=choose-a-strong-password
PLAYGROUND_AUTH_SECRET=replace-with-a-long-random-secret

# Optional local override for the SQLite database file
DATA_API_PLAYGROUND_DB_PATH=/absolute/path/to/app.db

# Optional client-side API base used by mock/demo helpers
NEXT_PUBLIC_API_URL=http://localhost:8000
